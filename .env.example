# Copy to .env (never commit the real file) and fill in your own values.
DB_URL=jdbc:postgresql://localhost:5432/tendering
DB_USERNAME=postgres
DB_PASSWORD=change-me
# 256-bit+ random value, e.g.: openssl rand -base64 64
JWT_SECRET=change-me
# Optional: SMTP account used for password-reset e-mails
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: comma-separated phone numbers that receive a fixed OTP in test mode
SMS_TEST_NUMBERS=
FIREBASE_PROJECT_ID=
